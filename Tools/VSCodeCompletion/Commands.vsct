  <Extern href="stdidcmd.h" /><Extern href="vsshlids.h" />
  <Commands package="guidPackage">
    <Groups><Group guid="guidCommands" id="MainGroup" priority="0x0600"><Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" /></Group></Groups>
    <Buttons>
      <Button guid="guidCommands" id="Complete" priority="0x0100" type="Button"><Parent guid="guidCommands" id="MainGroup" /><Strings><ButtonText>Local Completion: 補完する</ButtonText><CommandName>LocalCompletion.Complete</CommandName></Strings></Button>
      <Button guid="guidCommands" id="Toggle" priority="0x0200" type="Button"><Parent guid="guidCommands" id="MainGroup" /><Strings><ButtonText>Local Completion: 自動補完を切り替え</ButtonText><CommandName>LocalCompletion.Toggle</CommandName></Strings></Button>
      <Button guid="guidCommands" id="Test" priority="0x0300" type="Button"><Parent guid="guidCommands" id="MainGroup" /><Strings><ButtonText>Local Completion: 接続テスト</ButtonText><CommandName>LocalCompletion.TestConnection</CommandName></Strings></Button>
    </Buttons>
  </Commands>
  <KeyBindings><KeyBinding guid="guidCommands" id="Complete" editor="guidVSStd97" key1="VK_RETURN" mod1="CONTROL ALT" /></KeyBindings>
  <Symbols>
